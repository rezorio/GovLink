generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  MAYOR
  DEPT_HEAD
  BARANGAY_CAPTAIN
  BARANGAY_SECRETARY
}

enum DirectiveCategory {
  DISASTER_PREPAREDNESS
  FINANCIAL_ADMINISTRATION
  PEACE_AND_ORDER
  SOCIAL_PROTECTION
  ADMINISTRATIVE_GOVERNANCE
}

enum TaskAssignmentStatus {
  PENDING_ACK
  ACKNOWLEDGED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  RETURNED
  OVERDUE
}

enum EvidenceSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  RETURNED
}

enum ReviewDecision {
  ACCEPTED
  RETURNED
}

enum ComplianceFrequency {
  SEMESTRAL
  ANNUAL
  TERM
  ONGOING
  AD_HOC
  MONTHLY
}

enum ComplianceScope {
  BARANGAY
  MUNICIPAL
}

enum ComplianceCategory {
  ADMINISTRATIVE
  SOCIAL
  YOUTH
  MUNICIPAL_SUPERVISION
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  RETURNED
  OVERDUE
}

/// RA 11292 / DILG Seal of Good Local Governance assessment areas
enum SglgPillar {
  FINANCIAL_ADMINISTRATION
  DISASTER_PREPAREDNESS
  SOCIAL_PROTECTION
  HEALTH_COMPLIANCE
  SUSTAINABLE_EDUCATION
  BUSINESS_FRIENDLINESS
  SAFETY_PEACE_ORDER
  ENVIRONMENTAL_MANAGEMENT
  TOURISM_CULTURE
  YOUTH_DEVELOPMENT
}

enum ExportFormat {
  PDF
  XLSX
}

enum ProcurementRegime {
  RA9184
  RA12009
}

enum IncomeClass {
  BARANGAY
  MUNICIPALITY_1ST
  MUNICIPALITY_2ND
  MUNICIPALITY_3RD
  MUNICIPALITY_4TH
  MUNICIPALITY_5TH
  CITY
  PROVINCE
}

enum ProcurementMode {
  SHOPPING
  SVP
  COMPETITIVE_BIDDING
  DIRECT
}

enum AppLineStatus {
  DRAFT
  APPROVED
}

enum ContractStatus {
  DRAFT
  PLANNED
  RFQ_ISSUED
  QUOTATIONS_RECEIVED
  EVALUATION
  AWARD_RECOMMENDED
  AWARDED
  ACTIVE
  COMPLETED
}

enum ProcurementDocType {
  RFQ
  QUOTATION
  ABSTRACT
  BAC_RESOLUTION
  NOTICE_OF_AWARD
  CONTRACT_DOC
  DELIVERY_RECEIPT
  INSPECTION_ACCEPTANCE
}

enum BacDesignation {
  CHAIR
  VICE_CHAIR
  MEMBER
}

enum ResidentRecordType {
  RESIDENT
  KASAMBAHAY
}

enum NotificationKind {
  TASK_ASSIGNED
  EVIDENCE_SUBMITTED
  REVIEW_ACCEPTED
  REVIEW_RETURNED
  COMPLIANCE_SUBMITTED
  COMPLIANCE_ACCEPTED
  COMPLIANCE_RETURNED
  PLAN_SUBMITTED
  PLAN_ACCEPTED
  PLAN_RETURNED
  ASSEMBLY_SUBMITTED
  ASSEMBLY_ACCEPTED
  ASSEMBLY_RETURNED
}

enum PlanType {
  BDP
  AIP
}

enum PlanSubmissionStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  ACCEPTED
  RETURNED
}

enum AssemblySemester {
  H1
  H2
}

enum AssemblySubmissionStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  ACCEPTED
  RETURNED
}

model Municipality {
  id                 String            @id @default(uuid())
  name               String
  province           String
  region             String
  psgcCode           String            @unique @map("psgc_code")
  incomeClass        IncomeClass       @default(MUNICIPALITY_4TH) @map("income_class")
  procurementRegime  ProcurementRegime @default(RA12009) @map("procurement_regime")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  barangays            Barangay[]
  users                User[]
  supervisoryTasks     SupervisoryTask[]
  taskAssignments      TaskAssignment[]
  complianceInstances  ComplianceInstance[]
  exportDocuments      ExportDocument[]
  auditLogs            AuditLog[]
  appLineItems         AppLineItem[]
  procurementContracts ProcurementContract[]
  procurementDocuments ProcurementDocument[]
  bacMembers           BacMember[]
  barangayResidents    BarangayResident[]
  notifications         Notification[]
  planSubmissions       PlanSubmission[]
  assemblySubmissions   AssemblySubmission[]

  @@map("municipalities")
}

model Barangay {
  id             String   @id @default(uuid())
  municipalityId String   @map("municipality_id")
  name           String
  psgcCode       String   @map("psgc_code")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  municipality         Municipality          @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  users                User[]
  taskAssignments      TaskAssignment[]
  complianceInstances  ComplianceInstance[]
  exportDocuments      ExportDocument[]
  auditLogs            AuditLog[]
  appLineItems         AppLineItem[]
  procurementContracts ProcurementContract[]
  procurementDocuments ProcurementDocument[]
  bacMembers           BacMember[]
  barangayResidents    BarangayResident[]
  notifications         Notification[]
  planSubmissions       PlanSubmission[]
  assemblySubmissions   AssemblySubmission[]

  @@unique([municipalityId, psgcCode])
  @@index([municipalityId])
  @@map("barangays")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  municipalityId String    @map("municipality_id")
  barangayId     String?   @map("barangay_id")
  roles          AppRole[]
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id])
  barangay     Barangay?    @relation(fields: [barangayId], references: [id])

  assignedTasks         SupervisoryTask[]     @relation("AssignedBy")
  acknowledgedTasks     TaskAssignment[]      @relation("AcknowledgedBy")
  reviews               MunicipalReview[]
  complianceSubmissions ComplianceInstance[]  @relation("ComplianceSubmittedBy")
  complianceReviews     ComplianceInstance[]  @relation("ComplianceReviewedBy")
  exportDocuments       ExportDocument[]
  auditLogs             AuditLog[]
  splitAcknowledgedContracts ProcurementContract[] @relation("SplitAcknowledgedBy")
  procurementDocumentsUploaded ProcurementDocument[] @relation("ProcurementDocUploadedBy")
  procurementDocumentsVoided   ProcurementDocument[] @relation("ProcurementDocVoidedBy")
  bacMemberships               BacMember[]           @relation("BacMemberUser")
  bacDesignations              BacMember[]           @relation("BacDesignatedBy")
  notifications                Notification[]
  planSubmissionsSubmitted     PlanSubmission[]      @relation("PlanSubmittedBy")
  planSubmissionsReviewed      PlanSubmission[]      @relation("PlanReviewedBy")
  assemblySubmissionsSubmitted AssemblySubmission[]  @relation("AssemblySubmittedBy")
  assemblySubmissionsReviewed  AssemblySubmission[]  @relation("AssemblyReviewedBy")

  @@index([municipalityId, barangayId])
  @@map("users")
}

model DirectiveTemplate {
  id           String            @id @default(uuid())
  title        String
  category     DirectiveCategory
  dilgMcNumber String            @unique @map("dilg_mc_number")
  description  String
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  supervisoryTasks SupervisoryTask[]

  @@map("directive_templates")
}

model ComplianceRequirement {
  id            String               @id @default(uuid())
  code          String               @unique
  title         String
  legalBasis    String               @map("legal_basis")
  category      ComplianceCategory
  frequency     ComplianceFrequency
  evidenceTypes String[]             @map("evidence_types")
  weight        Int                  @default(1)
  scope         ComplianceScope      @default(BARANGAY)
  sglgPillar    SglgPillar?          @map("sglg_pillar")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  instances ComplianceInstance[]

  @@index([category, scope])
  @@index([sglgPillar])
  @@map("compliance_requirements")
}

model ComplianceInstance {
  id             String           @id @default(uuid())
  municipalityId String           @map("municipality_id")
  barangayId     String           @map("barangay_id")
  requirementId  String           @map("requirement_id")
  periodLabel    String           @map("period_label")
  dueDate        DateTime         @map("due_date") @db.Date
  status         ComplianceStatus @default(NOT_STARTED)
  submittedAt    DateTime?        @map("submitted_at")
  submittedById  String?          @map("submitted_by_id")
  reviewedAt     DateTime?        @map("reviewed_at")
  reviewedById   String?          @map("reviewed_by_id")
  returnReason   String?          @map("return_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  municipality Municipality           @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay               @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  requirement  ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  submittedBy  User?                  @relation("ComplianceSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?                  @relation("ComplianceReviewedBy", fields: [reviewedById], references: [id])

  @@unique([barangayId, requirementId, periodLabel])
  @@index([municipalityId, barangayId, status])
  @@index([municipalityId, periodLabel])
  @@index([barangayId, status, dueDate])
  @@map("compliance_instances")
}

model SupervisoryTask {
  id                  String    @id @default(uuid())
  municipalityId      String    @map("municipality_id")
  directiveTemplateId String?   @map("directive_template_id")
  title               String
  description         String
  legalBasis          String    @map("legal_basis")
  assignedById        String    @map("assigned_by_id")
  dueDate             DateTime  @map("due_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  municipality      Municipality       @relation(fields: [municipalityId], references: [id])
  directiveTemplate DirectiveTemplate? @relation(fields: [directiveTemplateId], references: [id])
  assignedBy        User               @relation("AssignedBy", fields: [assignedById], references: [id])
  assignments       TaskAssignment[]

  @@index([municipalityId, dueDate])
  @@map("supervisory_tasks")
}

model TaskAssignment {
  id               String               @id @default(uuid())
  municipalityId   String               @map("municipality_id")
  barangayId       String               @map("barangay_id")
  taskId           String               @map("task_id")
  status           TaskAssignmentStatus @default(PENDING_ACK)
  acknowledgedAt   DateTime?            @map("acknowledged_at")
  acknowledgedById String?              @map("acknowledged_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  municipality        Municipality         @relation(fields: [municipalityId], references: [id])
  task                SupervisoryTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  barangay            Barangay             @relation(fields: [barangayId], references: [id])
  acknowledgedBy      User?                @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  evidenceSubmissions EvidenceSubmission[]
  reviews             MunicipalReview[]

  @@unique([taskId, barangayId])
  @@index([municipalityId, barangayId, status])
  @@index([barangayId, status])
  @@map("task_assignments")
}

model EvidenceSubmission {
  id            String                   @id @default(uuid())
  municipalityId String                  @map("municipality_id")
  barangayId    String                   @map("barangay_id")
  assignmentId  String                   @map("assignment_id")
  fileKey       String                   @map("file_key")
  fileName      String                   @map("file_name")
  mimeType      String                   @map("mime_type")
  fileSizeBytes Int                      @map("file_size_bytes")
  status        EvidenceSubmissionStatus @default(DRAFT)
  submittedAt   DateTime?                @map("submitted_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  assignment TaskAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviews    MunicipalReview[]

  @@index([municipalityId, barangayId])
  @@index([assignmentId])
  @@map("evidence_submissions")
}

model MunicipalReview {
  id             String         @id @default(uuid())
  municipalityId String         @map("municipality_id")
  assignmentId   String         @map("assignment_id")
  submissionId   String?        @map("submission_id")
  reviewerId     String         @map("reviewer_id")
  decision       ReviewDecision
  comment        String?
  reviewedAt     DateTime       @default(now()) @map("reviewed_at")

  assignment TaskAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission EvidenceSubmission? @relation(fields: [submissionId], references: [id])
  reviewer   User                @relation(fields: [reviewerId], references: [id])

  @@index([municipalityId, assignmentId])
  @@map("municipal_reviews")
}

model AuditLog {
  id             String   @id @default(uuid())
  municipalityId String   @map("municipality_id")
  barangayId     String?  @map("barangay_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id])
  barangay     Barangay?    @relation(fields: [barangayId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([municipalityId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ExportDocument {
  id             String       @id @default(uuid())
  documentToken  String       @unique @map("document_token")
  contentHash    String       @map("content_hash")
  reportType     String       @map("report_type")
  format         ExportFormat
  municipalityId String       @map("municipality_id")
  barangayId     String?      @map("barangay_id")
  generatedById  String       @map("generated_by_id")
  generatedAt    DateTime     @default(now()) @map("generated_at")
  revokedAt      DateTime?    @map("revoked_at")
  revokeReason   String?      @map("revoke_reason")
  periodLabel    String?      @map("period_label")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  barangay     Barangay?    @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  generatedBy  User         @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([municipalityId, generatedAt])
  @@index([municipalityId, reportType, periodLabel])
  @@index([municipalityId, barangayId])
  @@index([contentHash])
  @@map("export_documents")
}

model ProcurementThreshold {
  id                String            @id @default(uuid())
  regime            ProcurementRegime
  incomeClass       IncomeClass       @map("income_class")
  mode              ProcurementMode
  maxAmountCentavos BigInt            @map("max_amount_centavos")
  effectiveFrom     DateTime          @map("effective_from") @db.Date
  gppbReference     String?           @map("gppb_reference")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([regime, incomeClass, mode, effectiveFrom])
  @@index([regime, incomeClass, mode])
  @@map("procurement_thresholds")
}

model AppLineItem {
  id                     String        @id @default(uuid())
  municipalityId         String        @map("municipality_id")
  barangayId             String        @map("barangay_id")
  fiscalYear             Int           @map("fiscal_year")
  code                   String
  description            String
  category               String
  approvedAmountCentavos BigInt        @map("approved_amount_centavos")
  status                 AppLineStatus @default(DRAFT)
  sglgPillar             SglgPillar    @default(FINANCIAL_ADMINISTRATION) @map("sglg_pillar")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  municipality Municipality          @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay              @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  contracts    ProcurementContract[]

  @@unique([barangayId, fiscalYear, code])
  @@index([municipalityId, fiscalYear])
  @@index([barangayId, fiscalYear])
  @@map("app_line_items")
}

model ProcurementContract {
  id                       String          @id @default(uuid())
  municipalityId           String          @map("municipality_id")
  barangayId               String          @map("barangay_id")
  appLineItemId            String          @map("app_line_item_id")
  title                    String
  supplierName             String          @map("supplier_name")
  amountCentavos           BigInt          @map("amount_centavos")
  mode                     ProcurementMode
  status                   ContractStatus  @default(DRAFT)
  fiscalYear               Int             @map("fiscal_year")
  category                 String
  splittingRiskScore       Int?            @map("splitting_risk_score")
  splittingFlagged         Boolean         @default(false) @map("splitting_flagged")
  splittingAcknowledgedAt  DateTime?       @map("splitting_acknowledged_at")
  splittingAcknowledgedById String?        @map("splitting_acknowledged_by_id")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  municipality            Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay                Barangay     @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  appLineItem             AppLineItem  @relation(fields: [appLineItemId], references: [id], onDelete: Restrict)
  splittingAcknowledgedBy User?        @relation("SplitAcknowledgedBy", fields: [splittingAcknowledgedById], references: [id])
  documents               ProcurementDocument[]

  @@index([barangayId, fiscalYear])
  @@index([municipalityId, fiscalYear, status])
  @@index([municipalityId, splittingFlagged])
  @@index([barangayId, category, fiscalYear])
  @@map("procurement_contracts")
}

model ProcurementDocument {
  id                       String             @id @default(uuid())
  municipalityId           String             @map("municipality_id")
  barangayId               String             @map("barangay_id")
  contractId               String             @map("contract_id")
  docType                  ProcurementDocType @map("doc_type")
  title                    String
  fileKey                  String?            @map("file_key")
  fileName                 String?            @map("file_name")
  mimeType                 String?            @map("mime_type")
  fileSizeBytes            Int?               @map("file_size_bytes")
  contentSha256            String?            @map("content_sha256")
  notes                    String?
  quotationSupplierName    String?            @map("quotation_supplier_name")
  quotationAmountCentavos  BigInt?            @map("quotation_amount_centavos")
  version                  Int                @default(1)
  voidedAt                 DateTime?          @map("voided_at")
  voidReason               String?            @map("void_reason")
  voidedById               String?            @map("voided_by_id")
  uploadedById             String             @map("uploaded_by_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  municipality Municipality        @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay            @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  contract     ProcurementContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy   User                @relation("ProcurementDocUploadedBy", fields: [uploadedById], references: [id])
  voidedBy     User?               @relation("ProcurementDocVoidedBy", fields: [voidedById], references: [id])

  @@index([contractId, docType])
  @@index([municipalityId, barangayId])
  @@index([contractId, voidedAt])
  @@map("procurement_documents")
}

/// Barangay Bids and Awards Committee roster (RA 9184 IRR Sec. 7.3.2).
/// Punong Barangay designates members; PB is not a voting BAC member.
model BacMember {
  id               String         @id @default(uuid())
  municipalityId   String         @map("municipality_id")
  barangayId       String         @map("barangay_id")
  userId           String?        @map("user_id")
  displayName      String         @map("display_name")
  designation      BacDesignation
  termStart        DateTime       @map("term_start") @db.Date
  designationDate  DateTime       @map("designation_date") @db.Date
  isActive         Boolean        @default(true) @map("is_active")
  designatedById   String         @map("designated_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay     @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  user         User?        @relation("BacMemberUser", fields: [userId], references: [id])
  designatedBy User         @relation("BacDesignatedBy", fields: [designatedById], references: [id])

  @@index([barangayId, isActive])
  @@index([municipalityId, barangayId])
  @@map("bac_members")
}

/// Barangay household / kasambahay registry entries (RA 10173 personal data).
model BarangayResident {
  id             String             @id @default(uuid())
  municipalityId String             @map("municipality_id")
  barangayId     String             @map("barangay_id")
  fullName       String             @map("full_name")
  addressLine    String             @map("address_line")
  phone          String
  birthYear      Int?               @map("birth_year")
  recordType     ResidentRecordType @default(RESIDENT) @map("record_type")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay     @relation(fields: [barangayId], references: [id], onDelete: Cascade)

  @@index([barangayId])
  @@index([municipalityId, barangayId])
  @@map("barangay_residents")
}

/// In-app notification for municipal and barangay users (email/SMS deferred).
model Notification {
  id               String           @id @default(uuid())
  municipalityId   String           @map("municipality_id")
  barangayId       String?          @map("barangay_id")
  recipientUserId  String           @map("recipient_user_id")
  kind             NotificationKind
  title            String
  body             String
  entityType       String           @map("entity_type")
  entityId         String           @map("entity_id")
  href             String?
  readAt           DateTime?        @map("read_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay?    @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([municipalityId, createdAt])
  @@map("notifications")
}

/// Barangay Development Plan (BDP) and Annual Investment Program (AIP) submission tracker.
model PlanSubmission {
  id             String               @id @default(uuid())
  municipalityId String               @map("municipality_id")
  barangayId     String               @map("barangay_id")
  planType       PlanType             @map("plan_type")
  periodLabel    String               @map("period_label")
  dueDate        DateTime             @map("due_date") @db.Date
  status         PlanSubmissionStatus @default(NOT_STARTED)
  title          String?
  notes          String?
  fileKey        String?              @map("file_key")
  fileName       String?              @map("file_name")
  submittedAt    DateTime?            @map("submitted_at")
  submittedById  String?              @map("submitted_by_id")
  reviewedAt     DateTime?            @map("reviewed_at")
  reviewedById   String?              @map("reviewed_by_id")
  returnReason   String?              @map("return_reason")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay     @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("PlanSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("PlanReviewedBy", fields: [reviewedById], references: [id])

  @@unique([barangayId, planType, periodLabel])
  @@index([municipalityId, planType, periodLabel])
  @@index([barangayId, status])
  @@map("plan_submissions")
}

/// Semestral barangay assembly + report tracker (RA 7160 Sec. 397(b); Proc. 260).
model AssemblySubmission {
  id              String                   @id @default(uuid())
  municipalityId  String                   @map("municipality_id")
  barangayId      String                   @map("barangay_id")
  semester        AssemblySemester
  periodLabel     String                   @map("period_label")
  dueDate         DateTime                 @map("due_date") @db.Date
  status          AssemblySubmissionStatus @default(NOT_STARTED)
  title           String?
  notes           String?
  heldAt          DateTime?                @map("held_at") @db.Date
  venue           String?
  attendanceCount Int?                     @map("attendance_count")
  fileKey         String?                  @map("file_key")
  fileName        String?                  @map("file_name")
  submittedAt     DateTime?                @map("submitted_at")
  submittedById   String?                  @map("submitted_by_id")
  reviewedAt      DateTime?                @map("reviewed_at")
  reviewedById    String?                  @map("reviewed_by_id")
  returnReason    String?                  @map("return_reason")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  barangay     Barangay     @relation(fields: [barangayId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("AssemblySubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("AssemblyReviewedBy", fields: [reviewedById], references: [id])

  @@unique([barangayId, periodLabel])
  @@index([municipalityId, periodLabel])
  @@index([barangayId, status])
  @@map("assembly_submissions")
}
