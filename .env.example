# PostgreSQL — GovLink always uses host port 5433 (not 5432) so other projects can keep 5432.
# docker-compose maps GOVLINK_PG_PORT → container 5432. Keep DATABASE_URL in sync if you override.
GOVLINK_PG_PORT=5433
DATABASE_URL="postgresql://govlink:govlink@localhost:5433/govlink?schema=public"

# Runtime: development | test | production
NODE_ENV=development

# Auth (Mission 2)
# Production: must be ≥32 chars and not a demo placeholder (boot refuses otherwise).
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRES_IN_HOURS=8

# File uploads (MinIO / S3-compatible)
S3_BUCKET=govlink-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=govlink
S3_SECRET_ACCESS_KEY=govlinksecret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760

# Comma-separated browser origins allowed by CORS (defaults to FRONTEND_URL).
# FRONTEND_URL=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=https://govlink.example.gov.ph

# Public base for QR verification links (no trailing slash)
# Production: must be https:// unless ALLOW_INSECURE_PUBLIC_URL=true (LAN pilots only).
PUBLIC_BASE_URL=http://localhost:3000
# ALLOW_INSECURE_PUBLIC_URL=true
PORT=3000

# Seed safety: db:seed refuses when NODE_ENV=production unless this is true.
# ALLOW_SEED_IN_PRODUCTION=true
