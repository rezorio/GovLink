# PostgreSQL (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://govlink:govlink@localhost:5432/govlink?schema=public"

# Auth (Mission 2)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRES_IN_HOURS=8

# File uploads (Mission 3+)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760

NODE_ENV=development
PORT=3000
